modules = ["nodejs-22", "postgresql-16"]
run = "pnpm dev"
entrypoint = "artifacts/api/src/index.ts"
hidden = [".config", "node_modules", "dist", ".cache", ".local"]

[nix]
channel = "stable-25_05"

[env]
PORT = "5000"
NODE_ENV = "development"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm build"]
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Dev server"

[[workflows.workflow]]
name = "Dev server"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000
