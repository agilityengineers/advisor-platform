# ---- Required ---------------------------------------------------------------
# Replit Postgres connection string (Replit sets this automatically).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advisor_platform
# Signs JWTs. 32+ random bytes. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for per-company integration secrets. If unset, one is generated
# on first boot and stored in platform_config (set it explicitly in production).
PLATFORM_ENCRYPTION_KEY=
# Password for the super admin (Clarence Williams, emailme@clarencewilliams.com).
# Re-synced on every boot. Mandatory in production.
SUPER_ADMIN_PASSWORD=

# ---- Platform identity ------------------------------------------------------
# Primary platform host. Company subdomains hang off PLATFORM_SUBDOMAIN_BASE.
PLATFORM_PRIMARY_DOMAIN=advisor-platform.findabusinesspro.com
PLATFORM_SUBDOMAIN_BASE=advisor-platform.findabusinesspro.com
# Comma-separated list of hosts that resolve to the platform (not a company).
PLATFORM_HOSTS=advisor-platform.com,www.advisor-platform.com,advisor-platform.findabusinesspro.com,advisor-platform.authority-desk.com
# Public URL used in emails when no tenant host applies.
APP_URL=https://advisor-platform.findabusinesspro.com

# ---- Optional dev conveniences ----------------------------------------------
# Give the seeded MTC admin (Brian Traichel) a password in development.
MTC_ADMIN_PASSWORD=
# Seed demo companies (Northstar Advisory, Career Pro Guider) in development.
SEED_DEMO=false

# ---- Platform-level provider keys (Replit Secrets) --------------------------
# Platform SendGrid (invites, resets, partner mail from partner@).
SENDGRID_API_KEY=
PLATFORM_FROM_EMAIL=partner@advisor-platform.findabusinesspro.com
PLATFORM_FROM_NAME=Advisor Platform
# Bright Data (Profile Grader). Platform-level, never per company. Dataset gd_l1viktl72bvl7bjuj0.
BRIGHTDATA_API_KEY=
# Outside production the grader scores deterministic sample profiles whenever the key is unset. Force it with:
GRADER_DEMO=
# Platform Stripe account (Connect: company checkouts are direct charges on each connected account).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Connect webhook endpoint pointed at /api/webhooks/stripe ("listen to events on connected accounts").
STRIPE_WEBHOOK_SECRET=
# Stripe Connect OAuth client id (ca_…) for the "Connect with Stripe" button; owners can paste an acct_ id without it.
STRIPE_CONNECT_CLIENT_ID=
# Outside production the checkout runs in demo mode whenever STRIPE_SECRET_KEY is unset (no card is charged). Force it with:
CHECKOUT_DEMO=
# Calendly webhooks are registered per company from Company settings → Integrations; each signing key lives in company_secrets.

# ---- Runtime -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
